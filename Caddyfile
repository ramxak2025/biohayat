# Автоматический HTTPS (Let's Encrypt) для домена из переменной DOMAIN.
# Caddy сам получит и продлит сертификат.
{$DOMAIN} {
	encode gzip zstd
	reverse_proxy app:3000
}

# www.домен → основной домен (сертификат выпускается и для www автоматически)
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# Оптовый поддомен (B2B): то же приложение, режим определяется по Host.
# Перед запуском добавьте в Beget DNS A-запись opt -> IP сервера.
{$OPT_DOMAIN:opt.biohayat.ru} {
	encode gzip zstd
	reverse_proxy app:3000
}
