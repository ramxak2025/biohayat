# Общий API сайта. Все EXPO_PUBLIC_* значения доступны в сборке приложения.
EXPO_PUBLIC_API_URL=https://new.biohayat.ru/api/v2

# Для локального серверного рабочего дерева с API v2 задайте адрес в .env.local:
# EXPO_PUBLIC_API_URL=http://localhost:3187/api/v2
# На физическом устройстве используйте LAN-адрес компьютера вместо localhost.
