// BioHayat / ХАЯТ — модель данных
// PostgreSQL + Prisma. Цены хранятся в копейках (Int) во избежание ошибок округления.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
//  Администраторы / личный кабинет
// ─────────────────────────────────────────────
enum AdminRole {
  ADMIN // полный доступ, включая настройки и интеграции
  EDITOR // контент: товары, категории, материалы, баннеры
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ─────────────────────────────────────────────
//  Каталог: категории и товары
// ─────────────────────────────────────────────
model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  // изображение-обложка категории (плитка)
  image       String?
  icon        String? // имя иконки lucide или путь
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  // SEO (заполняется автоматически из name/description, редактируется вручную)
  metaTitle       String?
  metaDescription String? @db.Text
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive, sortOrder])
}

model Product {
  id               String  @id @default(cuid())
  slug             String  @unique
  name             String
  shortDescription String? @db.Text
  description      String? @db.Text

  // Специфика БАД
  composition      String? @db.Text // Состав
  usage            String? @db.Text // Способ применения
  contraindications String? @db.Text // Противопоказания
  volume           String? // Объём / масса / форма выпуска (напр. "60 капсул")
  sku              String? @unique // артикул

  // Цены в копейках
  priceKopecks    Int
  oldPriceKopecks Int?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images ProductImage[]
  badges String[] // напр. ["хит", "новинка", "акция"]

  // Навигация по трём осям каталога:
  audiences String[] // кому: "men" | "women" | "kids"
  goals     String[] // зачем: "weight-loss" | "mass-gain" | "immunity" | ...
  nutrients String[] // ключевые компоненты для проверки совместимости БАД

  inStock    Boolean @default(true)
  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)

  // SEO
  metaTitle       String?
  metaDescription String? @db.Text
  ogImage         String?

  orderItems  OrderItem[]
  favorites   Favorite[]
  intakePlans IntakePlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, sortOrder])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)

  @@index([productId, sortOrder])
}

// ─────────────────────────────────────────────
//  Рекламные блоки / баннеры
// ─────────────────────────────────────────────
enum BannerPlacement {
  HERO // главный слайдер на главной
  HOME_STRIP // промо-полоса на главной
  CATEGORY // баннер в каталоге
  SIDEBAR // боковой блок
  POPUP // всплывающий промо
}

model Banner {
  id        String          @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  imageMobile String?
  ctaLabel  String?
  link      String?
  placement BannerPlacement @default(HOME_STRIP)
  bgColor   String? // hex-фон под изображение/заглушку
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

// ─────────────────────────────────────────────
//  Материалы / статьи / блог
// ─────────────────────────────────────────────
model Material {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  content     String    @db.Text // HTML/Markdown
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  // SEO
  metaTitle       String?
  metaDescription String? @db.Text
  ogImage         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, publishedAt])
}

// ─────────────────────────────────────────────
//  Заявки / заказы (уходят лидами в Битрикс24)
// ─────────────────────────────────────────────
enum OrderStatus {
  NEW // новая заявка
  CONFIRMED // подтверждена менеджером
  PAID // оплачена
  ASSEMBLING // на сборке/отгрузке
  SHIPPED // передана в доставку
  IN_TRANSIT // в пути
  DELIVERED // доставлена/выполнена
  CANCELLED // отменена
}

enum BitrixSyncStatus {
  PENDING
  SYNCED
  FAILED
  DISABLED
}

model Order {
  id           String      @id @default(cuid())
  number       Int         @unique @default(autoincrement())
  customerName String
  phone        String
  email        String?
  address      String?
  comment      String?     @db.Text
  totalKopecks Int
  status       OrderStatus @default(NEW)

  // согласие на обработку перс. данных (152-ФЗ)
  consentGiven Boolean  @default(false)
  consentAt    DateTime?

  // Связь с зарегистрированным покупателем (если оформлял из ЛК)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Интеграция с Битрикс24
  bitrixLeadId     String?
  bitrixDealId     String?
  bitrixSyncStatus BitrixSyncStatus @default(PENDING)
  bitrixError      String?          @db.Text

  // Доставка / трекинг (СДЭК и др.)
  trackingNumber  String?
  trackingCarrier String? @default("cdek")

  // источник / utm
  source String?
  utm    Json?

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([bitrixSyncStatus])
  @@index([customerId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name         String
  priceKopecks Int
  qty          Int      @default(1)

  @@index([orderId])
}

// ─────────────────────────────────────────────
//  Промокоды
// ─────────────────────────────────────────────
enum DiscountType {
  PERCENT
  FIXED
}

model PromoCode {
  id              String       @id @default(cuid())
  code            String       @unique
  description     String?
  discountType    DiscountType @default(PERCENT)
  value           Int // процент (1..100) или копейки
  minOrderKopecks Int          @default(0)
  isActive        Boolean      @default(true)
  usageLimit      Int? // null = без лимита
  usedCount       Int          @default(0)
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ─────────────────────────────────────────────
//  Настройки сайта (singleton, id = "default")
//  Контакты, юр-данные (152-ФЗ / schema.org), Битрикс24, SEO по умолчанию.
// ─────────────────────────────────────────────
model SiteSettings {
  id String @id @default("default")

  // Контакты
  siteName     String  @default("ХАЯТ")
  phone        String  @default("+7 (928) 677-50-50")
  email        String  @default("info@biohayat.ru")
  address      String  @default("г. Грозный, ул. Нурседы Хабусиевой, 51")
  workingHours String  @default("Пн–Вс, 9:00–18:00")

  // Соцсети
  instagram String?
  telegram  String?
  whatsapp  String?
  vk        String?
  wildberries String?

  // Юридические реквизиты (для футера, оферты, 152-ФЗ, schema.org)
  legalName String? // ООО «...» / ИП ...
  inn       String?
  ogrn      String?
  legalAddress String?

  // Доставка
  freeDeliveryThresholdKopecks Int @default(2000000) // 20 000 ₽

  // Интеграция Битрикс24
  bitrixWebhookUrl String? // входящий вебхук REST
  bitrixEnabled    Boolean @default(false)
  bitrixChatCode   String? @db.Text // HTML/JS код виджета онлайн-чата (Открытые линии)
  bitrixResponsibleId String? // ID ответственного за лиды
  // Приёмник статусов из Битрикс24 (исходящий вебхук на стороне Битрикс24)
  bitrixWebhookToken String? // секрет в URL приёмника /api/bitrix/webhook?token=...
  bitrixStageMap     Json?   // { "STAGE_ID": "DELIVERED", ... } стадия сделки → статус заказа

  // SEO по умолчанию
  defaultMetaTitle       String  @default("ХАЯТ — натуральные витамины и БАД для всей семьи")
  defaultMetaDescription String  @db.Text @default("Фитопродукция и биологически активные добавки ХАЯТ: витамины, коллаген, масло чёрного тмина и многое другое.")
  defaultOgImage         String?
  titleTemplate          String  @default("%s — ХАЯТ")
  yandexVerification     String?
  googleVerification     String?

  // Аналитика
  yandexMetrikaId String?

  // Контент-настройки (юр. дисклеймер для БАД)
  badDisclaimer String @db.Text @default("БАД. НЕ ЯВЛЯЕТСЯ ЛЕКАРСТВЕННЫМ СРЕДСТВОМ. Имеются противопоказания, необходима консультация специалиста.")

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  Покупатели (личный кабинет, вход по телефону)
// ─────────────────────────────────────────────
model Customer {
  id           String    @id @default(cuid())
  phone        String    @unique // нормализованный +7XXXXXXXXXX
  passwordHash String
  name         String
  email        String?
  city         String?
  birthDate    DateTime?
  gender       String? // "male" | "female" | null
  bonusBalance Int       @default(0) // бонусные баллы (программа лояльности)
  notifyPrefs  Json? // настройки уведомлений { email, sms, marketing }
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  orders        Order[]
  favorites     Favorite[]
  intakePlans   IntakePlan[]
  consultations ConsultationRequest[]
  addresses     Address[]
  devices       Device[]

  @@index([createdAt])
}

// Сохранённые адреса доставки (для быстрого оформления и повторных заказов)
model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String? // «Дом», «Работа»
  recipient  String?
  phone      String?
  city       String
  street     String
  house      String?
  apartment  String?
  comment    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// Устройства для push-уведомлений (мобильное приложение на React Native)
model Device {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   String // "ios" | "android"
  pushToken  String
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([customerId, pushToken])
  @@index([customerId])
}

model Favorite {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
}

// ─────────────────────────────────────────────
//  Трекер приёма БАД
// ─────────────────────────────────────────────
model IntakePlan {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title        String // название курса/добавки
  times        String[] // времена приёма, напр. ["09:00","21:00"]
  startDate    DateTime @default(now())
  durationDays Int? // длительность курса (null = бессрочно)
  note         String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs IntakeLog[]

  @@index([customerId, isActive])
}

model IntakeLog {
  id      String     @id @default(cuid())
  planId  String
  plan    IntakePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  day     String // дата приёма YYYY-MM-DD
  slot    String // время-слот, напр. "09:00"
  takenAt DateTime   @default(now())

  @@unique([planId, day, slot])
  @@index([planId, day])
}

// ─────────────────────────────────────────────
//  Заявки на консультацию нутрициолога
// ─────────────────────────────────────────────
enum ConsultationStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

model ConsultationRequest {
  id         String             @id @default(cuid())
  customerId String?
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  topic      String? // тема консультации
  message    String?            @db.Text
  status     ConsultationStatus @default(NEW)

  bitrixLeadId     String?
  bitrixSyncStatus BitrixSyncStatus @default(PENDING)
  bitrixError      String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// ─────────────────────────────────────────────
//  Совместимость БАД (синергия / антагонизм / осторожно)
// ─────────────────────────────────────────────
enum CompatibilityType {
  SYNERGY // усиливают друг друга
  ANTAGONIST // нельзя вместе / мешают усвоению
  CAUTION // с осторожностью
}

model CompatibilityRule {
  id         String            @id @default(cuid())
  componentA String // напр. "Кальций"
  componentB String // напр. "Железо"
  type       CompatibilityType
  note       String?           @db.Text
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([isActive])
}
