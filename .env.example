# ─────────────────────────────────────────────────────────────
#  BioHayat / ХАЯТ — переменные окружения
#  Скопируйте этот файл в `.env` и заполните значения.
# ─────────────────────────────────────────────────────────────

# База данных (PostgreSQL). В Docker-деплое host = db (см. docker-compose).
DATABASE_URL="postgresql://biohayat:biohayat@db:5432/biohayat?schema=public"

# Пароль пользователя БД в Docker (подставляется в DATABASE_URL автоматически).
POSTGRES_PASSWORD="смените-на-надёжный-пароль"

# Секрет для подписи сессий (минимум 32 символа).
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET="change-me-please-use-a-long-random-string-min-32-chars"

# Базовый публичный URL сайта (для sitemap, canonical, og:url).
# С доменом: https://biohayat.ru   |  без домена: http://IP_СЕРВЕРА:3000
NEXT_PUBLIC_SITE_URL="https://biohayat.ru"

# Домен для автоматического HTTPS через Caddy (профиль proxy).
DOMAIN="biohayat.ru"

# ── Учётные данные первого администратора (используются сидом) ──
ADMIN_EMAIL="admin@biohayat.ru"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Администратор"

# ── Интеграция с Битрикс24 (можно также задать в админке) ──
BITRIX24_WEBHOOK_URL=""
